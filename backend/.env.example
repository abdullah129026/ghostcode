# GhostCode API configuration. Copy to .env for local dev.
# Every variable has a sane default; set only what you need to change.

# Log level: DEBUG, INFO, WARNING, ERROR
GHOSTCODE_LOG_LEVEL=INFO

# CORS origins, comma-separated. The public API is stateless, so * is fine.
GHOSTCODE_CORS_ORIGINS=*

# Analysis job caps
GHOSTCODE_CLONE_TIMEOUT=120
GHOSTCODE_MAX_JOBS=100

# Repo size caps (ingest/walk.py)
GHOSTCODE_MAX_FILES=5000
GHOSTCODE_MAX_FILE_BYTES=1048576

# Rate limits: requests per minute and burst, per IP
GHOSTCODE_ANALYZE_RATE_PER_MIN=20
GHOSTCODE_ANALYZE_RATE_BURST=5
GHOSTCODE_READ_RATE_PER_MIN=120
GHOSTCODE_READ_RATE_BURST=30

# Auto-PR sandbox (autopr/sandbox.py): per-command wall-clock timeout in
# seconds and the child address-space cap in MB.
GHOSTCODE_SANDBOX_TIMEOUT=600
GHOSTCODE_SANDBOX_MEM_MB=2048
