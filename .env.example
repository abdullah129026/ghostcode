# Copy to .env (never commit the real one). All optional unless noted.
GHOSTCODE_MAX_FILES=20000
GHOSTCODE_MAX_FILE_BYTES=1000000
# Day 4: HTTP API
PORT=8000
GHOSTCODE_CLONE_TIMEOUT=120
GHOSTCODE_MAX_JOBS=100
GHOSTCODE_ANALYZE_RATE_PER_MIN=20
GHOSTCODE_ANALYZE_RATE_BURST=5
GHOSTCODE_READ_RATE_PER_MIN=120
GHOSTCODE_READ_RATE_BURST=30
GHOSTCODE_CORS_ORIGINS=*
# Day 6: token used by auto-PR to open branches and pull requests.
GHOSTCODE_GITHUB_TOKEN=
